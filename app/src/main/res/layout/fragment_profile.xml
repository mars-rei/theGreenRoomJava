<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#1e1e1e"
    android:paddingTop="54dp"
    android:paddingHorizontal="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- header / banner photo -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="160sp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardPreventCornerOverlap="false"
            app:cardUseCompatPadding="true">

            <ImageView
                android:id="@+id/header_photo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/header_placeholder"
                android:contentDescription="@string/edit_header_photo" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/username"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="50dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/username"
            android:textSize="32dp"
            android:textColor="#878E76"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/bio"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bio"
            android:textSize="18dp"
            android:textColor="#EDEDE9" />

        <LinearLayout
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/location_icon"
                android:layout_width="14dp"
                android:layout_height="16dp"
                android:scaleType="centerCrop"
                android:src="@drawable/location"
                android:contentDescription="location icon" />

            <TextView
                android:id="@+id/location"
                android:layout_marginStart="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/location"
                android:textSize="18dp"
                android:textColor="#EDEDE9" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_edit_profile"
            android:layout_marginTop="8dp"
            android:layout_width="135dp"
            android:layout_height="48dp"
            android:paddingHorizontal="16dp"
            android:layout_marginHorizontal="20dp"
            android:backgroundTint="#878E76"
            android:text="Edit profile"
            android:textColor="#1C1C1A"
            android:textSize="18sp" />


        <!-- showcase, about and schedule sections -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="20dp">

                <TextView
                    android:id="@+id/showcase"
                    android:layout_marginHorizontal="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/showcase"
                    android:textSize="20sp"
                    android:textColor="#EDEDE9"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/about"
                    android:layout_marginHorizontal="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/about"
                    android:textSize="20sp"
                    android:textColor="#EDEDE9"
                    android:clickable="true"
                    android:focusable="true"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/schedule"
                    android:layout_marginHorizontal="10dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/schedule"
                    android:textSize="20sp"
                    android:textColor="#EDEDE9"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/profile_section_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/profile_section_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="16dp" />
            </ScrollView>

        </LinearLayout>

    </LinearLayout>

    <!-- profile photo -->
    <androidx.cardview.widget.CardView
        android:layout_width="120sp"
        android:layout_height="120sp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="84dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:cardPreventCornerOverlap="false"
        app:cardUseCompatPadding="true">

        <ImageView
            android:id="@+id/profile_picture"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/profile_placeholder"
            android:contentDescription="@string/edit_profile_picture" />
    </androidx.cardview.widget.CardView>

    <!-- events, friends, and rating (not functional yet) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="175dp"
        android:layout_marginTop="154dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="20dp">
            <TextView
                android:id="@+id/events_num"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18dp"
                android:textColor="#EDEDE9"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/events"
                android:textSize="18dp"
                android:textColor="#EDEDE9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginEnd="20dp">
            <TextView
                android:id="@+id/friends_num"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18dp"
                android:textColor="#EDEDE9"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/friends"
                android:textSize="18dp"
                android:textColor="#EDEDE9" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/rating_num"
                android:layout_marginTop="8dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="18dp"
                android:textColor="#EDEDE9"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rating"
                android:textSize="18dp"
                android:textColor="#EDEDE9" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>